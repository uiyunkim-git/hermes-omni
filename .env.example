# =====================================================================================
#  Hermes 설정 — 사람이 정하는 값만. cp .env.example .env 후 채우고 ./setup.sh 실행.
#  (hub 가 있으면 더 간단히: hub UI 의 "머신 추가" 에서 복사한 명령 ./setup.sh --join <blob>)
#  .env 는 git 에 올라가지 않는다. 수정 후 `docker compose up -d` 로 반영
#  (LLM_* 는 컨테이너 부팅마다 config.yaml 에 덮어씀 — 비워두면 그 항목은 건드리지 않음).
#  머신별 값(GPU, 작업 폴더 경로 등)은 setup.sh 가 docker-compose.override.yml 에 자동 생성한다.
# =====================================================================================

# --- LLM (OpenAI 호환 /v1 엔드포인트) ---------------------------------------------------
LLM_BASE_URL=https://tom.kaist.ac.kr/glm/v1
LLM_MODEL=zai-org/GLM-5.3-Flash
LLM_API_KEY=
# chat_completions | anthropic_messages | codex_responses
LLM_API_MODE=chat_completions
LLM_CONTEXT_LENGTH=326144

# --- Hermes Desktop 로그인 (hub UI 로그인도 hub 머신의 이 값) ------------------------------
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Desktop 에서 로그인할 때 입력할 비밀번호 (직접 정하기)
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# --- Tailscale (tailnet 에만 :9119 노출) --------------------------------------------------
# 첫 로그인용 auth key (https://login.tailscale.com/admin/settings/keys).
# 비우면 setup.sh 가 보여주는 로그인 URL 로 승인. 한 번 로그인하면 ./tailscale/state 에 남아 이후엔 불필요.
TS_AUTHKEY=
# tailnet 노드 이름 (비우면 hermes-<호스트명>)
TS_HOSTNAME=

# --- hermes-omni (여러 머신을 hub 하나로) -------------------------------------------------
# hub  = 이 머신이 hub (웹 UI·APK·에이전트 간 메시지 중계). tailnet 에 하나만. hub 도 node 역할을 겸한다.
# node = hub 에 등록되는 일반 머신 (기본값). 아래 HUB_URL·HUB_JOIN_TOKEN 이 필요하다.
HERMES_ROLE=node
# node 전용: hub 주소와 가입 토큰 — hub UI 의 "머신 추가" 화면에 나온다 (--join 이면 자동으로 채워짐)
HUB_URL=
HUB_JOIN_TOKEN=
# 에이전트가 다룰 프로젝트 폴더들의 상위 폴더 (선택, 쉼표로 구분, 절대 경로, 미리 만들어 둘 것)
# 각 폴더의 하위 폴더 하나하나가 프로젝트. ./workspace 는 항상 포함된다.
# 컨테이너에도 같은 절대 경로로 연결된다. 예: PROJECT_ROOTS=/home/me/src,/data/research
PROJECT_ROOTS=

# --- 선택 옵션 (보통 그대로) --------------------------------------------------------------
# HERMES_GPU=auto            # auto | on | off — nvidia GPU 전부 패스스루
# HERMES_TAILSCALE=on        # on | off
# HERMES_BIND=127.0.0.1      # 호스트에도 9119 를 열 주소 (0.0.0.0 = LAN 전체, 비권장)
# HERMES_PORT=9119
# HERMES_APPLY_ENV_CONFIG=0  # LLM_* → config.yaml 반영 끔 (Desktop 에서 고른 모델 유지)
# TS_EXTRA_ARGS=--advertise-tags=tag:hermes
# HERMES_IMAGE=nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db
# NODE_ID=                   # hub 에서 쓰는 이 머신 이름 (주소 <node>/<project>). 비우면 TS_HOSTNAME 또는 호스트명, 한 번 정해지면 유지
# HUB_BIND=                  # hub 머신: 호스트에도 hub UI 를 열 주소 (예: 127.0.0.1, 0.0.0.0 = LAN, 비권장). 비우면 tailnet 에만
# HUB_PORT=8800              # HUB_BIND 를 쓸 때 호스트 포트
TZ=Asia/Seoul
