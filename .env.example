# =====================================================================================
#  Hermes 설정 — ./setup.sh 가 이 파일을 .env 로 복사하고 비밀값/머신 값을 채운다.
#  .env 는 git 에 올라가지 않는다. 수정 후 `docker compose up -d` 하면 반영된다
#  (모델 관련 값은 컨테이너 부팅마다 config.yaml 에 덮어씀 — 비워두면 그 항목은 건드리지 않음).
# =====================================================================================

# --- LLM (OpenAI 호환 /v1 엔드포인트) ---------------------------------------------------
LLM_BASE_URL=https://tom.kaist.ac.kr/glm/v1
LLM_MODEL=zai-org/GLM-5.3-Flash
LLM_API_KEY=
# chat_completions | anthropic_messages | codex_responses
LLM_API_MODE=chat_completions
LLM_CONTEXT_LENGTH=326144

# --- Hermes Desktop 로그인 (setup.sh 가 비밀번호/서명키를 무작위 생성) ---------------------
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- 접속 경로 ---------------------------------------------------------------------------
# 호스트에 9119 를 어느 주소로 열지. 127.0.0.1 (기본, + tailscale serve) / 0.0.0.0 (LAN 전체)
HERMES_BIND=127.0.0.1
HERMES_PORT=9119

# --- 머신별 값 (setup.sh 가 자동으로 채움) -------------------------------------------------
# 에이전트 작업 폴더 — 호스트와 컨테이너에서 같은 절대 경로
HERMES_WORKSPACE=
# 컨테이너 안 hermes 사용자 UID/GID (data/, workspace/ 파일 소유자)
HERMES_UID=10000
HERMES_GID=10000
# auto | on | off  — nvidia GPU 패스스루
HERMES_GPU=auto
# setup.sh 가 HERMES_GPU 와 docker-compose.override.yml 존재 여부로 계산. 직접 고치지 말 것.
COMPOSE_FILE=docker-compose.yml

# --- 기타 -------------------------------------------------------------------------------
TZ=Asia/Seoul
# HERMES_IMAGE=nousresearch/hermes-agent:latest
# HERMES_CONTAINER_NAME=hermes
# DOCKER_SOCK=/var/run/docker.sock
# 0 이면 .env → config.yaml 반영을 끔 (Desktop 에서 고른 모델을 재시작 후에도 유지하고 싶을 때)
# HERMES_APPLY_ENV_CONFIG=0
