#!/command/with-contenv sh
# shellcheck shell=sh
# Apply .env → $HERMES_HOME/config.yaml on every container boot, so .env stays the
# single source of truth across restarts, reboots and machines.
#
# Runs as root after 01-hermes-setup (volume chown + config seeding) and before the
# gateway/dashboard start. `hermes` here is the image's privilege-drop shim, so writes
# land as the hermes user. Empty variables are skipped (that key keeps whatever is in
# config.yaml — e.g. a model picked in Desktop). HERMES_APPLY_ENV_CONFIG=0 disables it.
set -u

# Desktop 세션 토큰 서명키: 사람이 정할 값이 아니므로 .env 가 아니라 Hermes 자체 비밀값 파일
# ($HERMES_HOME/.env, 이 폴더의 data/.env)에 한 번 생성해 둔다. 고정되어 있어야 재시작 후에도
# Desktop 로그인이 유지된다. 바꾸면(줄을 지우고 재시작) 모든 세션이 로그아웃된다.
secrets="${HERMES_HOME:-/opt/data}/.env"
if ! grep -q '^HERMES_DASHBOARD_BASIC_AUTH_SECRET=.' "$secrets" 2>/dev/null; then
    [ -e "$secrets" ] || { install -m 600 /dev/null "$secrets"; chown hermes:hermes "$secrets"; }
    printf '\nHERMES_DASHBOARD_BASIC_AUTH_SECRET=%s\n' \
        "$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 44)" >>"$secrets"
    echo "[env-config] generated dashboard session signing secret"
fi

# hermes-omni: a machine running an omni link (OMNI_LINK_TOKEN set by the generated compose
# override) needs the hub-bridge plugin enabled. `config set plugins.enabled` REPLACES the list,
# so merge with the current one. Never removes anything; a plugins.disabled entry wins.
# Runs regardless of HERMES_APPLY_ENV_CONFIG, which only governs the .env → config mapping below.
enable_plugin() {
    cfg="${HERMES_HOME:-/opt/data}/config.yaml"
    # Exit codes: 0 = print merged JSON list, 10 = already enabled, 11 = explicitly disabled.
    merged=$(/opt/hermes/.venv/bin/python - "$cfg" "$1" <<'PY'
import json, os, sys
import yaml
path, name = sys.argv[1], sys.argv[2]
cfg = {}
if os.path.exists(path):
    try:
        with open(path, encoding="utf-8") as f:
            cfg = yaml.safe_load(f) or {}
    except (OSError, yaml.YAMLError) as e:
        sys.exit(f"{path}: {' '.join(str(e).split())}")
if not isinstance(cfg, dict):
    sys.exit(f"{path}: top level is not a mapping")
plugins = cfg.get("plugins") or {}
if not isinstance(plugins, dict):
    sys.exit(f"{path}: 'plugins' is not a mapping")
disabled = plugins.get("disabled") or []
if isinstance(disabled, list) and name in disabled:
    sys.exit(11)
enabled = plugins.get("enabled")
if enabled is None:
    enabled = []
if not isinstance(enabled, list) or not all(isinstance(x, str) for x in enabled):
    sys.exit(f"{path}: plugins.enabled is not a list of names: {enabled!r}")
if name in enabled:
    sys.exit(10)
print(json.dumps(enabled + [name]))
PY
    )
    case $? in
        0)  if out=$(hermes config set plugins.enabled "$merged" 2>&1); then
                echo "[env-config] plugins.enabled += $1 → $merged"
            else
                echo "[env-config] WARN: could not enable plugin $1: $out" >&2
            fi ;;
        10) echo "[env-config] plugin $1 already enabled" ;;
        11) echo "[env-config] WARN: plugin $1 is in plugins.disabled; leaving it disabled" >&2 ;;
        *)  echo "[env-config] WARN: could not read plugins from $cfg; $1 not enabled" >&2 ;;
    esac
}

# hermes-omni: Hermes Tool Search hides every plugin tool behind its tool_call bridge, and weaker
# models garble that nested call (`calls` sent as a broken JSON string), so "work with that session"
# failed before hub_send ever ran. With Tool Search off, hub_send/hub_directory/hub_inbox are ordinary
# direct tools (a few extra schemas; cheap at these context sizes). Only an unset or "auto" value is
# changed: an explicit on/off in config.yaml is the operator's choice and stays.
tool_search_off() {
    cfg="${HERMES_HOME:-/opt/data}/config.yaml"
    # Exit codes: 0 = set it off, 10 = already off, 11 = explicitly on.
    /opt/hermes/.venv/bin/python - "$cfg" <<'PY'
import os, sys
import yaml
path = sys.argv[1]
cfg = {}
if os.path.exists(path):
    try:
        with open(path, encoding="utf-8") as f:
            cfg = yaml.safe_load(f) or {}
    except (OSError, yaml.YAMLError) as e:
        sys.exit(f"{path}: {' '.join(str(e).split())}")
ts = ((cfg.get("tools") or {}) if isinstance(cfg, dict) else {}).get("tool_search")
value = ts.get("enabled", "auto") if isinstance(ts, dict) else ("off" if ts is False else "auto")
value = {True: "on", False: "off"}.get(value, str(value).strip().lower())
if value in ("off", "false", "no", "0"):
    sys.exit(10)
if value in ("on", "true", "yes", "1"):
    sys.exit(11)
PY
    case $? in
        0)  if out=$(hermes config set tools.tool_search.enabled off 2>&1); then
                echo "[env-config] tools.tool_search.enabled → off (hub tools stay direct)"
            else
                echo "[env-config] WARN: could not turn Tool Search off: $out" >&2
            fi ;;
        10) echo "[env-config] Tool Search already off" ;;
        11) echo "[env-config] WARN: tools.tool_search.enabled is on; hub tools stay behind tool_call" >&2 ;;
        *)  echo "[env-config] WARN: could not read tools.tool_search from $cfg; left unchanged" >&2 ;;
    esac
}

if [ -n "${OMNI_LINK_TOKEN:-}" ]; then
    enable_plugin hub-bridge
    tool_search_off
fi

case "${HERMES_APPLY_ENV_CONFIG:-1}" in
    0|false|no) echo "[env-config] disabled (HERMES_APPLY_ENV_CONFIG=0)"; exit 0 ;;
esac

apply() {
    [ -n "$2" ] || return 0
    if hermes config set "$1" "$2" >/dev/null 2>&1; then
        echo "[env-config] $1 applied"
    else
        echo "[env-config] WARN: could not set $1" >&2
    fi
}

if [ -n "${LLM_BASE_URL:-}" ]; then
    apply model.provider custom
    apply model.base_url "$LLM_BASE_URL"
    apply model.api_mode "${LLM_API_MODE:-chat_completions}"
fi
apply model.default "${LLM_MODEL:-}"
apply model.api_key "${LLM_API_KEY:-}"
apply model.context_length "${LLM_CONTEXT_LENGTH:-}"
apply terminal.cwd "${HERMES_WORKSPACE:-}"

exit 0
