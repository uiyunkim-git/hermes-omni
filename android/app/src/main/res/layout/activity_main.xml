<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView is created in code and inserted at index 0 (so it can be rebuilt after a renderer crash). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MergeRootFrame"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ProgressBar
      android:id="@+id/progress"
      style="@android:style/Widget.Material.ProgressBar.Horizontal"
      android:layout_width="match_parent"
      android:layout_height="2dp"
      android:layout_gravity="top"
      android:indeterminate="false"
      android:max="100"
      android:progressTint="@color/accent"
      android:progressBackgroundTint="@android:color/transparent"
      android:visibility="gone" />

  <!-- Connection-error screen: calm, text-first; shown only for hub main-frame failures. -->
  <ScrollView
      android:id="@+id/error_panel"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/surface"
      android:clickable="true"
      android:fillViewport="true"
      android:focusable="true"
      android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="48dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

      <ImageView
          android:layout_width="56dp"
          android:layout_height="56dp"
          android:layout_marginBottom="24dp"
          android:alpha="0.6"
          android:contentDescription="@null"
          android:src="@drawable/ic_splash" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:lineSpacingExtra="4sp"
          android:text="@string/error_title"
          android:textColor="@color/text_primary"
          android:textSize="20sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:breakStrategy="balanced"
          android:lineBreakWordStyle="phrase"
          tools:targetApi="33"
          android:gravity="center"
          android:lineSpacingExtra="5sp"
          android:maxWidth="320dp"
          android:text="@string/error_hint"
          android:textColor="@color/text_secondary"
          android:textSize="15sp" />

      <TextView
          android:id="@+id/error_detail"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:fontFamily="monospace"
          android:gravity="center"
          android:lineSpacingExtra="3sp"
          android:maxWidth="320dp"
          android:textColor="@color/text_tertiary"
          android:textIsSelectable="true"
          android:textSize="13sp" />

      <Button
          android:id="@+id/error_retry"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:layout_marginTop="32dp"
          android:background="@drawable/btn_primary"
          android:fontFamily="sans-serif-medium"
          android:minWidth="176dp"
          android:paddingStart="24dp"
          android:paddingEnd="24dp"
          android:stateListAnimator="@null"
          android:text="@string/error_retry"
          android:textAllCaps="false"
          android:textColor="@color/on_accent"
          android:textSize="15sp" />

      <Button
          android:id="@+id/error_change_hub"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:layout_marginTop="8dp"
          android:background="@drawable/btn_text"
          android:minWidth="176dp"
          android:paddingStart="24dp"
          android:paddingEnd="24dp"
          android:stateListAnimator="@null"
          android:text="@string/change_hub"
          android:textAllCaps="false"
          android:textColor="@color/accent"
          android:textSize="15sp" />
    </LinearLayout>
  </ScrollView>
</FrameLayout>
