<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button: accent fill, 24dp radius, ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/pressed">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/accent" />
      <corners android:radius="24dp" />
    </shape>
  </item>
</ripple>
