<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Auto-retry the error screen when a network (e.g. the Tailscale VPN) comes up. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Self-update: open the downloaded hermes-omni.apk in the package installer. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- No CAMERA permission on purpose: ACTION_IMAGE_CAPTURE works without it, and declaring it
       would make the camera intent fail until the user grants it. -->

  <!-- Package visibility (API 30+): find camera apps for the file chooser and grant them the
       capture URI. -->
  <queries>
    <intent>
      <action android:name="android.media.action.IMAGE_CAPTURE" />
    </intent>
  </queries>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:theme="@style/AppTheme"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:usesCleartextTraffic="true"
      tools:ignore="DataExtractionRules">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Camera output for the WebView file chooser (cacheDir/capture/*.jpg only). -->
    <provider
        android:name=".CaptureProvider"
        android:authorities="${applicationId}.capture"
        android:exported="false"
        android:grantUriPermissions="true" />
  </application>
</manifest>
